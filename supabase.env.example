# Supabase configuration for Retard Sorter (local desktop auth/licensing).
# Copy this file to supabase.env next to the executable and fill in values.
# NEVER commit supabase.env — it contains secrets.
# After filling it in, run "retard-sorter.exe -encrypt-env" so the secrets are
# stored machine-bound encrypted (supabase.env.enc) and the plaintext is deleted.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
